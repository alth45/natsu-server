# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Virtual env
venv/
.venv/
env/
ENV/

# Node / Electron
node_modules/
npm-debug.log*
electron-app/dist/
*.asar

# PyInstaller
apps/build/
apps/dist/

# Backup
*.bak
*.backup
backup/

# Binary runtime (portable engines — JANGAN commit binary-nya, cukup strukturnya)
# Catatan: `!bin/**/` wajib ada supaya git berani masuk subfolder yang tadi di-ignore
bin/**/*
!bin/**/
!bin/.gitkeep
!bin/**/.gitkeep
!bin/**/README.md

# Data & runtime (jangan commit isi database / log lokal)
data/**/*
!data/**/
!data/**/.gitkeep
!data/**/README.md
www/**/*
!www/**/
!www/**/.gitkeep
!www/**/README.md
logs/**/*
!logs/**/
!logs/**/.gitkeep
*.log
*.pid
config/my.ini
config/nginx.conf
config/natsu-settings.json
config/certs/
config/vhosts/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini